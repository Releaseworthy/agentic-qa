# Environment: live
# Production: real data, so READ_ONLY — only @readonly tests run, nothing is seeded, and there is
# no admin account for the tests. START_APP runs a local stand-in on :3300.
# Committed on purpose: secrets in here are enc1.… tokens, decryptable only with $STRING_HEX_SHOPLITE.
# Machine-local overrides go in env/.env.live.local (gitignored). Real env vars win over both.

BASE_URL=http://localhost:3300
START_APP=true
TEST_HOOKS=false
READ_ONLY=true

# Saved accounts global setup signs in before the run (comma-separated Account values)
PRELOGIN_ACCOUNTS=returning-customer

# Account.RETURNING_CUSTOMER
RETURNING_CUSTOMER_EMAIL=enc1.c9ZuCVguL7Z79P_1WHTaNGzlVg0mMbsMRAvah0U9zB0._6D_6mBkncPGHaDH.XdZLmRavNWZ4bYgOpgyu2OaAv9bo2C7dhrs.bQazRQnoLcNFuAG1dxWywA
