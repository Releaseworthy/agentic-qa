{
  "name": "agentic-qa",
  "description": "Agentic QA platform: AI-orchestrated test planning, AC refinement, API/UI test generation, impact-based regression and Go/No-Go release gates — on Playwright, Claude Agent SDK and Hybrid RAG",
  "author": "Lan Hoang <hoanglan9569@gmail.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "setup": "bun install --frozen-lockfile && bun run browsers && uv sync && bun run rag:build",
    "app": "bun run framework/setup/app-server.ts",
    "app:defects": "SHOPLITE_DEFECTS=all bun run framework/setup/app-server.ts",
    "test": "bun --bun playwright test --project=api --project=chromium",
    "test:api": "bun --bun playwright test --project=api",
    "test:ui": "bun --bun playwright test --project=chromium",
    "test:all": "bun --bun playwright test",
    "test:smoke": "bun --bun playwright test --project=api --project=chromium --grep @smoke",
    "test:unit": "bun test tests/unit",
    "test:staging": "TEST_ENV=staging bun --bun playwright test --project=api --project=chromium",
    "test:live": "TEST_ENV=live bun --bun playwright test --project=api --project=chromium",
    "report": "bun --bun playwright show-report",
    "browsers": "playwright install chromium firefox webkit && playwright-cli install-browser chromium",
    "qa:impact": "bun run qa/impact.ts",
    "qa:trace": "bun run qa/traceability.ts",
    "qa:gate": "bun run qa/release-gate.ts",
    "qa:defects": "bun run qa/defect-detection.ts",
    "qa:triage": "bun run qa/defects.ts",
    "qa:manual": "bun run qa/manual-runs.ts",
    "qa:flaky": "bun run qa/flaky.ts",
    "qa:arrange": "bun run framework/setup/arrange-cli.ts",
    "qa:heal-guard": "bun run qa/heal-guard.ts",
    "codesearch": "bun run codesearch/cli.ts",
    "mcp:code": "bun run codesearch/mcp.ts",
    "rag:build": "uv run python -m rag.build",
    "rag:eval": "uv run python -m rag.eval",
    "rag:serve": "uv run python -m rag.server --http",
    "rag:test": "uv run pytest",
    "kb:audit": "uv run python -m rag.curate audit",
    "kb:evaluate": "uv run python -m rag.curate evaluate",
    "agent": "bun run agents/run.ts",
    "tsc": "bun node_modules/typescript-7/bin/tsc",
    "typecheck": "bun run tsc --noEmit",
    "lint": "bun --bun eslint .",
    "lint:fix": "bun --bun eslint . --fix",
    "format": "bun --bun prettier . --write",
    "format:check": "bun --bun prettier . --check",
    "crypto": "bun run scripts/crypto.ts"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.300",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/cli": "^0.1.22",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@vscode/ripgrep": "^1.18.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.8",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "marked": "^18.1.1",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.71.2",
    "zod": "^4.6.7"
  }
}
