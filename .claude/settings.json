{
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "mcp__knowledge",
      "mcp__codesearch",
      "Bash(bun run *)",
      "Bash(bun test *)",
      "Bash(bunx playwright test *)",
      "Bash(bunx playwright-cli *)",
      "Bash(uv run *)",
      "Bash(git diff *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(TEST_ENV=* bunx playwright test *)",
      "Bash(TEST_ENV=* bun run *)",
      "Bash(git show *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh api *)",
      "Bash(cd *)",
      "Bash(grep *)",
      "Bash(tail *)",
      "Bash(head *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(echo *)",
      "Bash(sort *)"
    ],
    "deny": ["Bash(git push *)", "Bash(rm -rf *)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|mcp__knowledge__commit_knowledge|mcp__knowledge__upsert_document",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PROJECT_DIR}/agents/tool-policy-hook.ts\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
