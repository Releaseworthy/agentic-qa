{
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "mcp__knowledge",
      "mcp__codesearch",
      "Bash(bun run *)",
      "Bash(bun test *)",
      "Bash(bunx playwright test *)",
      "Bash(bunx playwright-cli *)",
