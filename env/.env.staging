# Environment: staging
# A deployed-like build: no test hooks, its own accounts. START_APP runs a local stand-in on :3200;
# against a real staging deployment, set BASE_URL to it and START_APP=false.
# Committed on purpose: secrets in here are enc1.… tokens, decryptable only with $STRING_HEX_SHOPLITE.
# Machine-local overrides go in env/.env.staging.local (gitignored). Real env vars win over both.

BASE_URL=http://localhost:3200
START_APP=true
TEST_HOOKS=false
READ_ONLY=false

# Saved accounts global setup signs in before the run (comma-separated Account values)
PRELOGIN_ACCOUNTS=admin,returning-customer

# Account.ADMIN
ADMIN_EMAIL=enc1.rUGrr8B7cZdObmie60gPW_ks18j9P3PSbpXKbB039J8.FfbvTJslUgNfyn0d.I1pM8ZbElX8MYJ9A1UrwUf5NTXhHF4HSAQVijJNt.ZzvSehp6xRxIwMGAMG2lkQ
