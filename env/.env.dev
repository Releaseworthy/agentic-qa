# Environment: dev
# ShopLite on this machine, started with the run. Test hooks on: seeded defects can be switched.
# Committed on purpose: secrets in here are enc1.… tokens, decryptable only with $STRING_HEX_SHOPLITE.
# Machine-local overrides go in env/.env.dev.local (gitignored). Real env vars win over both.

BASE_URL=http://localhost:3100
START_APP=true
TEST_HOOKS=true
READ_ONLY=false

# Saved accounts global setup signs in before the run (comma-separated Account values)
PRELOGIN_ACCOUNTS=admin,returning-customer

