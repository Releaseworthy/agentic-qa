{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["bun", "node"],
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "paths": {
      "@agents/*": ["./agents/*"],
      "@api": ["./framework/api/index.ts"],
      "@api/*": ["./framework/api/*"],
      "@app/*": ["./app/*"],
      "@auth/*": ["./framework/auth/*"],
      "@codesearch/*": ["./codesearch/*"],
      "@config/*": ["./framework/config/*"],
      "@data/*": ["./framework/data/*"],
      "@fixtures": ["./framework/fixtures.ts"],
      "@pages/*": ["./framework/pages/*"],
      "@qa/*": ["./qa/*"],
      "@setup/*": ["./framework/setup/*"],
      "@tests/*": ["./tests/*"],
      "@utils/*": ["./framework/utils/*"]
    },

    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "app",
    "framework",
    "tests",
    "qa",
    "codesearch",
    "agents",
    "scripts",
    "playwright.config.ts",
    "eslint.config.ts"
  ],
  "exclude": ["app/web"]
}
